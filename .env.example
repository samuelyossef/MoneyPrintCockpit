# Fill these only in runtime/setup.ps1. Never expose these values in the browser.
MPT_API_KEY=
MOONSHOT_API_KEY=
PEXELS_API_KEY=
UPLOAD_POST_API_KEY=
UPLOAD_POST_USERNAME=

# Gateway operation (contains no secret)
APP_ENV=local
ENABLE_API_DOCS=0
SHORT_STALE_MINUTES=45
LONG_STALE_MINUTES=180
QUEUE_STALE_MINUTES=360

# Local Growth OS (change the passwords outside the local environment)
GROWTH_POSTGRES_USER=moneyprinter
GROWTH_POSTGRES_PASSWORD=moneyprinter-local
GROWTH_POSTGRES_DB=moneyprinter
GROWTH_DATABASE_URL=postgresql://moneyprinter:moneyprinter-local@postgresql:5432/moneyprinter
TEMPORAL_ADDRESS=temporal:7233
GROWTH_TASK_QUEUE=growth-intelligence
MINIO_ROOT_USER=moneyprinter
MINIO_ROOT_PASSWORD=moneyprinter-local-storage
OBJECT_STORAGE_BUCKET=moneyprinter-media

# Stock material acceleration (contains no secret)
MATERIAL_PROVIDER_ORDER=pexels,pixabay,coverr
MATERIAL_SEARCH_CONCURRENCY=4
MATERIAL_DOWNLOAD_CONCURRENCY=3
MATERIAL_CACHE_MAX_BYTES=10737418240
MATERIAL_CACHE_TTL_HOURS=336
